{
  "name": "poketag",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @poketag/save-format && npm run dev -w @poketag/web",
    "build": "npm run build -w @poketag/save-format && npm run build -w @poketag/web",
    "test": "npm run test -w @poketag/save-format && npm run test -w @poketag/web",
    "lint": "npm run lint -w @poketag/web",
    "seed:demo": "NODE_OPTIONS='--experimental-strip-types' node --experimental-strip-types apps/web/scripts/seed-demo.ts",
    "clear:demo": "NODE_OPTIONS='--experimental-strip-types' node --experimental-strip-types apps/web/scripts/clear-demo.ts",
    "storage:check": "NODE_OPTIONS='--experimental-strip-types' node --experimental-strip-types apps/web/scripts/storage-check.ts",
    "storage:dummy": "NODE_OPTIONS='--experimental-strip-types' node --experimental-strip-types apps/web/scripts/r2-dummy-upload.ts",
    "auth:hash": "NODE_OPTIONS='--experimental-strip-types' node --experimental-strip-types apps/web/scripts/hash-password.ts",
    "smoke:vault": "NODE_OPTIONS='--experimental-strip-types' node --experimental-strip-types apps/web/scripts/smoke-vault.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
