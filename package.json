{
  "name": "poketag",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @poketag/save-format && npm run dev -w @poketag/web",
    "build": "npm run build -w @poketag/save-format && npm run build -w @poketag/web",
    "test": "npm run test -w @poketag/save-format",
    "lint": "npm run lint -w @poketag/web",
    "seed:demo": "NODE_OPTIONS='--experimental-sqlite --experimental-strip-types' node --experimental-strip-types apps/web/scripts/seed-demo.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
