# Copy to apps/web/.env.local for local development.
# Never commit real credentials.

# Metadata DB — local file (default) OR Turso for Vercel (docs/turso.md)
DATABASE_URL=file:../../data/poketag.sqlite
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Solo login (required to lock the vault). Generate hash:
#   npm run auth:hash -- 'your-password'
# Session secret: openssl rand -hex 32
# ---------------------------------------------------------------------------
# AUTH_USERNAME=suraj
# AUTH_PASSWORD_HASH=scrypt:16384:8:1:...
# AUTH_SESSION_SECRET=
# Optional: AUTH_SESSION_TTL_SECONDS=1209600
# Optional: AUTH_COOKIE_SECURE=true   # force Secure cookie (HTTPS)

# ---------------------------------------------------------------------------
# Object storage: "minio" (local Docker) or "r2" (Cloudflare).
# If unset, R2 is used when R2_ACCOUNT_ID / R2_ACCESS_KEY_ID is present.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=minio

# --- Local MinIO (docker compose up -d) ---
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=poketag
MINIO_SECRET_KEY=poketagsecret
MINIO_BUCKET=poketag-saves

# --- Cloudflare R2 (see docs/storage.md) ---
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=poketag-saves
# Optional overrides:
# R2_ENDPOINT=   # defaults to <accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_AUTO_CREATE_BUCKET=false

# When true, swap third-party sprites for placeholders (Phase 2+)
PUBLIC_MODE=false
