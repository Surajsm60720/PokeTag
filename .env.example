# Copy to apps/web/.env.local for local development.
# Never commit real credentials. Docker Compose defaults below are for local MinIO only.

# SQLite metadata (path relative to apps/web or absolute)
DATABASE_URL=file:../../data/poketag.sqlite

# Object storage (local MinIO via docker compose)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=poketag
MINIO_SECRET_KEY=poketagsecret
MINIO_BUCKET=poketag-saves

# When true, swap third-party sprites for placeholders (Phase 2+)
PUBLIC_MODE=false
